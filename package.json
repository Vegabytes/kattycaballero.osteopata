{
  "name": "katy-caballero-osteopata",
  "type": "module",
  "version": "1.0.0",
  "description": "Web de Katy Caballero - Osteópata y Masajista en Alpedrete, Madrid",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:create": "wrangler d1 create katy-clinica",
    "db:migrate": "wrangler d1 execute katy-clinica --file=db/schema.sql",
    "db:migrate:local": "wrangler d1 execute katy-clinica --file=db/schema.sql --local",
    "db:contabilidad": "wrangler d1 execute katy-clinica --file=db/migration-contabilidad.sql --remote",
    "db:contabilidad:local": "wrangler d1 execute katy-clinica --file=db/migration-contabilidad.sql --local",
    "db:gastos-recurrentes": "wrangler d1 execute katy-clinica --file=db/migration-gastos-recurrentes.sql --remote",
    "db:gastos-recurrentes:local": "wrangler d1 execute katy-clinica --file=db/migration-gastos-recurrentes.sql --local",
    "db:codigo-promo": "wrangler d1 execute katy-clinica --file=db/migration-codigo-promo.sql --remote",
    "db:codigo-promo:local": "wrangler d1 execute katy-clinica --file=db/migration-codigo-promo.sql --local",
    "draft": "node scripts/draft-post.mjs",
    "draft:list": "node scripts/draft-post.mjs --list",
    "draft:random": "node scripts/draft-post.mjs --random"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^8.1.0",
    "@astrojs/sitemap": "^3.0.0",
    "astro": "^4.0.0",
    "wrangler": "^4.72.0"
  }
}
