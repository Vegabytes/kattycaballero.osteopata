---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getResumenContable, getGastos, CATEGORIAS_GASTO, METODOS_PAGO } from '../../../lib/db';
import { getSetting, saveSetting } from '../../../lib/settings';

let mensaje = '';
let dbError = '';

// Guardar tipo de IVA configurable
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('_action') === 'iva') {
    const tipo = String(form.get('iva_servicios') || '0');
    try {
      await saveSetting(Astro, 'iva_servicios', tipo);
      mensaje = 'Configuración de IVA guardada';
    } catch (e: any) {
      dbError = e.message;
    }
  }
}

// --- Periodo seleccionado ---
const now = new Date();
const year = Number(Astro.url.searchParams.get('year')) || now.getFullYear();
const trimestreActual = 't' + (Math.floor(now.getMonth() / 3) + 1);
const t = Astro.url.searchParams.get('t') || (year === now.getFullYear() ? trimestreActual : 'anual');

const RANGOS: Record<string, { desde: string; hasta: string; label: string }> = {
  t1: { desde: `${year}-01-01`, hasta: `${year}-03-31`, label: 'T1 · Ene–Mar' },
  t2: { desde: `${year}-04-01`, hasta: `${year}-06-30`, label: 'T2 · Abr–Jun' },
  t3: { desde: `${year}-07-01`, hasta: `${year}-09-30`, label: 'T3 · Jul–Sep' },
  t4: { desde: `${year}-10-01`, hasta: `${year}-12-31`, label: 'T4 · Oct–Dic' },
  anual: { desde: `${year}-01-01`, hasta: `${year}-12-31`, label: 'Año completo' },
};
const rango = RANGOS[t] || RANGOS.anual;

// --- IVA configurado ---
let tipoIvaServicios = 0;
try {
  tipoIvaServicios = Number(await getSetting(Astro, 'iva_servicios')) || 0;
} catch { /* default 0 */ }

// --- Datos ---
let resumen: Awaited<ReturnType<typeof getResumenContable>> | null = null;
let gastos: Awaited<ReturnType<typeof getGastos>> = [];
try {
  [resumen, gastos] = await Promise.all([
    getResumenContable(Astro, rango.desde, rango.hasta, tipoIvaServicios),
    getGastos(Astro, { desde: rango.desde, hasta: rango.hasta }),
  ]);
} catch (e: any) {
  dbError = e.message;
  console.error('Contabilidad: error', e);
}

const fmt = (n: number) => (n || 0).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const ivaLiquidar = resumen ? resumen.ivaRepercutido - resumen.ivaSoportado : 0;
const years = [now.getFullYear(), now.getFullYear() - 1, now.getFullYear() - 2];

// Datos para export CSV (cliente)
const exportData = {
  periodo: `${rango.label} ${year}`,
  resumen,
  gastos,
  categorias: CATEGORIAS_GASTO,
  metodos: METODOS_PAGO,
};
---

<AdminLayout title="Contabilidad" activeSection="contabilidad">
  {dbError && (
    <div class="alert alert-error">
      <strong>Error de base de datos:</strong> {dbError}
      <br><small>¿Has ejecutado la migración? <code>npm run db:contabilidad</code></small>
    </div>
  )}
  {mensaje && <div class="alert alert-success">{mensaje}</div>}

  <div class="page-header">
    <h2>Contabilidad — {rango.label} {year}</h2>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <a href="/admin/contabilidad/gastos/nuevo" class="btn btn-primary">+ Añadir gasto</a>
      <a href="/admin/contabilidad/gastos" class="btn btn-secondary">Ver gastos</a>
      <button class="btn btn-secondary" id="btnExportCsv">Exportar CSV</button>
    </div>
  </div>

  <!-- Selector de periodo -->
  <form method="GET" class="periodo-bar">
    <div class="periodo-tabs">
      {Object.entries(RANGOS).map(([key, r]) => (
        <a href={`/admin/contabilidad?year=${year}&t=${key}`} class={`periodo-tab ${t === key ? 'active' : ''}`}>{r.label}</a>
      ))}
    </div>
    <select name="year" onchange="this.form.submit()">
      {years.map((y) => <option value={y} selected={y === year}>{y}</option>)}
    </select>
    <input type="hidden" name="t" value={t} />
  </form>

  <!-- Resumen -->
  <div class="conta-summary">
    <div class="conta-card conta-ingresos">
      <div class="conta-label">Ingresos cobrados</div>
      <div class="conta-value">{fmt(resumen?.ingresos || 0)}</div>
      <div class="conta-sub">Citas completadas en el periodo</div>
    </div>
    <div class="conta-card conta-gastos">
      <div class="conta-label">Gastos</div>
      <div class="conta-value">{fmt(resumen?.gastos || 0)}</div>
      <div class="conta-sub">{gastos.length} gasto{gastos.length === 1 ? '' : 's'} registrado{gastos.length === 1 ? '' : 's'}</div>
    </div>
    <div class={`conta-card ${(resumen?.resultado || 0) >= 0 ? 'conta-resultado-pos' : 'conta-resultado-neg'}`}>
      <div class="conta-label">Resultado</div>
      <div class="conta-value">{fmt(resumen?.resultado || 0)}</div>
      <div class="conta-sub">Ingresos − gastos</div>
    </div>
  </div>

  <div class="conta-grid">
    <!-- Ingresos por método de pago -->
    <div class="card">
      <h3 class="conta-h3">Cómo le han pagado</h3>
      {(!resumen || resumen.ingresosPorMetodo.length === 0) ? (
        <p class="conta-empty">Sin ingresos en este periodo.</p>
      ) : (
        <table>
          <thead><tr><th>Método</th><th style="text-align:right;">Citas</th><th style="text-align:right;">Total</th></tr></thead>
          <tbody>
            {resumen.ingresosPorMetodo.map((m) => (
              <tr>
                <td>{m.metodo === 'sin_especificar' ? <span style="color:var(--admin-text-light);">Sin especificar</span> : (METODOS_PAGO[m.metodo] || m.metodo)}</td>
                <td style="text-align:right;">{m.n}</td>
                <td style="text-align:right;font-weight:600;">{fmt(m.total)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

    <!-- Gastos por categoría -->
    <div class="card">
      <h3 class="conta-h3">Gastos por categoría</h3>
      {(!resumen || resumen.gastosPorCategoria.length === 0) ? (
        <p class="conta-empty">Sin gastos en este periodo. <a href="/admin/contabilidad/gastos/nuevo">Añadir uno</a>.</p>
      ) : (
        <table>
          <thead><tr><th>Categoría</th><th style="text-align:right;">Nº</th><th style="text-align:right;">Total</th></tr></thead>
          <tbody>
            {resumen.gastosPorCategoria.map((g) => (
              <tr>
                <td>{CATEGORIAS_GASTO[g.categoria] || g.categoria}</td>
                <td style="text-align:right;">{g.n}</td>
                <td style="text-align:right;font-weight:600;">{fmt(g.total)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </div>

  <!-- IVA -->
  <div class="card conta-iva-card">
    <div class="conta-iva-header">
      <h3 class="conta-h3" style="margin:0;">Resumen de IVA</h3>
      <form method="POST" class="conta-iva-config">
        <input type="hidden" name="_action" value="iva" />
        <label for="iva_servicios">IVA de mis servicios</label>
        <select id="iva_servicios" name="iva_servicios" onchange="this.form.submit()">
          <option value="0" selected={tipoIvaServicios === 0}>Exento / no facturo (0%)</option>
          <option value="21" selected={tipoIvaServicios === 21}>21%</option>
          <option value="10" selected={tipoIvaServicios === 10}>10%</option>
          <option value="4" selected={tipoIvaServicios === 4}>4%</option>
        </select>
      </form>
    </div>

    {tipoIvaServicios === 0 ? (
      <p class="conta-iva-note">
        Estás como <strong>exenta / no facturas</strong>: tus servicios no repercuten IVA.
        Aun así se registra el <strong>IVA soportado</strong> de tus gastos por si en el futuro pasas a declararlo.
      </p>
    ) : (
      <p class="conta-iva-note">
        Tus servicios repercuten un <strong>{tipoIvaServicios}%</strong> (se considera IVA incluido en el precio cobrado).
      </p>
    )}

    <div class="conta-iva-grid">
      <div class="conta-iva-item">
        <span class="conta-iva-label">IVA repercutido</span>
        <span class="conta-iva-val">{fmt(resumen?.ivaRepercutido || 0)}</span>
        <span class="conta-iva-help">Cobrado en servicios</span>
      </div>
      <div class="conta-iva-item">
        <span class="conta-iva-label">IVA soportado</span>
        <span class="conta-iva-val">{fmt(resumen?.ivaSoportado || 0)}</span>
        <span class="conta-iva-help">Deducible de gastos</span>
      </div>
      <div class={`conta-iva-item ${ivaLiquidar >= 0 ? 'conta-iva-pagar' : 'conta-iva-favor'}`}>
        <span class="conta-iva-label">{ivaLiquidar >= 0 ? 'IVA a ingresar' : 'IVA a tu favor'}</span>
        <span class="conta-iva-val">{fmt(Math.abs(ivaLiquidar))}</span>
        <span class="conta-iva-help">Repercutido − soportado</span>
      </div>
    </div>
    <p class="conta-disclaimer">Resumen orientativo para tu gestoría. No sustituye la declaración oficial.</p>
  </div>

  <!-- Gastos recientes del periodo -->
  <div class="card" style="margin-top:24px;">
    <div class="page-header" style="margin-bottom:16px;">
      <h3 class="conta-h3" style="margin:0;">Gastos del periodo</h3>
      <a href="/admin/contabilidad/gastos" class="btn btn-secondary btn-sm">Ver todos</a>
    </div>
    {gastos.length === 0 ? (
      <p class="conta-empty">Aún no hay gastos en este periodo. <a href="/admin/contabilidad/gastos/nuevo">Añadir el primero</a>.</p>
    ) : (
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Fecha</th><th>Concepto</th><th>Categoría</th>
              <th style="text-align:right;">Base</th><th style="text-align:right;">IVA</th><th style="text-align:right;">Total</th><th></th>
            </tr>
          </thead>
          <tbody>
            {gastos.slice(0, 12).map((g) => (
              <tr>
                <td style="white-space:nowrap;">{g.fecha}</td>
                <td><a href={`/admin/contabilidad/gastos/${g.id}`}>{g.concepto}</a>{g.deducible ? '' : <span class="badge-no-deducible">no deducible</span>}</td>
                <td>{CATEGORIAS_GASTO[g.categoria] || g.categoria}</td>
                <td style="text-align:right;">{fmt(g.base)}</td>
                <td style="text-align:right;">{fmt(g.iva)}</td>
                <td style="text-align:right;font-weight:600;">{fmt(g.total)}</td>
                <td style="text-align:right;"><a href={`/admin/contabilidad/gastos/${g.id}`} class="btn btn-secondary btn-sm">Editar</a></td>
              </tr>
            ))}
          </tbody>
        </table>
        {gastos.length > 12 && <p class="conta-empty" style="margin-top:12px;">… y {gastos.length - 12} más. <a href="/admin/contabilidad/gastos">Ver todos</a>.</p>}
      </div>
    )}
  </div>
</AdminLayout>

<script define:vars={{ exportData }}>
  document.getElementById('btnExportCsv')?.addEventListener('click', () => {
    const { resumen, gastos, categorias, metodos, periodo } = exportData;
    const eur = (n) => (Number(n) || 0).toFixed(2).replace('.', ',');
    let csv = `Contabilidad;${periodo}\n\n`;

    csv += 'INGRESOS POR METODO DE PAGO\nMetodo;Citas;Total\n';
    (resumen?.ingresosPorMetodo || []).forEach((m) => {
      const label = m.metodo === 'sin_especificar' ? 'Sin especificar' : (metodos[m.metodo] || m.metodo);
      csv += `${label};${m.n};"${eur(m.total)}"\n`;
    });
    csv += `Total ingresos;;"${eur(resumen?.ingresos || 0)}"\n\n`;

    csv += 'GASTOS\nFecha;Concepto;Categoria;Proveedor;Base;Tipo IVA;IVA;Total;Deducible;Pago\n';
    (gastos || []).forEach((g) => {
      csv += `${g.fecha};"${(g.concepto || '').replace(/"/g, "'")}";${categorias[g.categoria] || g.categoria};"${(g.proveedor || '').replace(/"/g, "'")}";"${eur(g.base)}";${g.tipo_iva}%;"${eur(g.iva)}";"${eur(g.total)}";${g.deducible ? 'Si' : 'No'};${metodos[g.metodo_pago] || ''}\n`;
    });
    csv += `Total gastos;;;;;;;"${eur(resumen?.gastos || 0)}"\n\n`;

    csv += 'RESUMEN\n';
    csv += `Ingresos;"${eur(resumen?.ingresos || 0)}"\n`;
    csv += `Gastos;"${eur(resumen?.gastos || 0)}"\n`;
    csv += `Resultado;"${eur(resumen?.resultado || 0)}"\n`;
    csv += `IVA repercutido;"${eur(resumen?.ivaRepercutido || 0)}"\n`;
    csv += `IVA soportado;"${eur(resumen?.ivaSoportado || 0)}"\n`;
    csv += `IVA a liquidar;"${eur((resumen?.ivaRepercutido || 0) - (resumen?.ivaSoportado || 0))}"\n`;

    const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `contabilidad-${periodo.replace(/[^a-zA-Z0-9]+/g, '-').toLowerCase()}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  });
</script>

<style is:global>
  .periodo-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .periodo-tabs { display: flex; gap: 6px; flex-wrap: wrap; }
  .periodo-tab {
    padding: 7px 14px;
    border-radius: 8px;
    border: 1px solid var(--admin-border);
    background: var(--admin-card);
    color: var(--admin-text);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.15s;
  }
  .periodo-tab:hover { border-color: var(--admin-primary); }
  .periodo-tab.active { background: var(--admin-primary); color: #fff; border-color: var(--admin-primary); }
  .periodo-bar select {
    padding: 7px 12px;
    border-radius: 8px;
    border: 1px solid var(--admin-border);
    background: var(--admin-card);
    color: var(--admin-text);
    font-size: 0.85rem;
    font-family: inherit;
    margin-left: auto;
  }

  .conta-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }
  .conta-card {
    border-radius: 12px;
    padding: 22px;
    border: 1px solid var(--admin-border);
    background: var(--admin-card);
  }
  .conta-label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--admin-text-light); margin-bottom: 6px; }
  .conta-value { font-size: 1.7rem; font-weight: 700; line-height: 1.1; }
  .conta-sub { font-size: 0.78rem; color: var(--admin-text-light); margin-top: 6px; }
  .conta-ingresos { border-left: 4px solid var(--admin-success); }
  .conta-ingresos .conta-value { color: #2e7d32; }
  .conta-gastos { border-left: 4px solid var(--admin-warning); }
  .conta-gastos .conta-value { color: #e65100; }
  .conta-resultado-pos { border-left: 4px solid var(--admin-info); }
  .conta-resultado-pos .conta-value { color: #1565c0; }
  .conta-resultado-neg { border-left: 4px solid var(--admin-danger); }
  .conta-resultado-neg .conta-value { color: #c62828; }

  .conta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }
  .conta-h3 { font-size: 0.95rem; font-weight: 600; margin-bottom: 14px; }
  .conta-empty { color: var(--admin-text-light); font-size: 0.88rem; padding: 8px 0; }

  .conta-iva-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .conta-iva-config { display: flex; align-items: center; gap: 8px; }
  .conta-iva-config label { font-size: 0.8rem; color: var(--admin-text-light); }
  .conta-iva-config select { padding: 6px 10px; border-radius: 8px; border: 1px solid var(--admin-border); background: var(--admin-card); color: var(--admin-text); font-size: 0.82rem; font-family: inherit; }
  .conta-iva-note { font-size: 0.85rem; color: var(--admin-text-light); margin-bottom: 16px; }
  .conta-iva-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .conta-iva-item { background: var(--admin-bg); border-radius: 10px; padding: 16px; display: flex; flex-direction: column; gap: 4px; }
  .conta-iva-label { font-size: 0.78rem; font-weight: 600; color: var(--admin-text-light); text-transform: uppercase; letter-spacing: 0.3px; }
  .conta-iva-val { font-size: 1.3rem; font-weight: 700; }
  .conta-iva-help { font-size: 0.72rem; color: var(--admin-text-light); }
  .conta-iva-pagar .conta-iva-val { color: #c62828; }
  .conta-iva-favor .conta-iva-val { color: #2e7d32; }
  .conta-disclaimer { font-size: 0.72rem; color: var(--admin-text-light); margin-top: 14px; font-style: italic; }

  .badge-no-deducible { display: inline-block; margin-left: 8px; font-size: 0.68rem; background: #fce4ec; color: #c62828; padding: 2px 7px; border-radius: 10px; font-weight: 600; }

  @media (max-width: 768px) {
    .conta-summary { grid-template-columns: 1fr; }
    .conta-grid { grid-template-columns: 1fr; }
    .conta-iva-grid { grid-template-columns: 1fr; }
    .periodo-bar select { margin-left: 0; }
  }
</style>
